# Backend — server-side only. Never commit real values.

# PostgreSQL (Supabase). Use the pooled connection string from the Supabase
# dashboard (Project Settings → Database → Connection string → URI, "Transaction
# pooler" variant for serverless-style deploys).
DATABASE_URL=

# Path to the Supabase CA certificate (download from Supabase Dashboard →
# Database Settings → SSL Configuration) for full TLS verification.
# Required in production for non-local databases.
DATABASE_SSL_CA=

# Clerk (server-side only).
CLERK_SECRET_KEY=

# Appwrite (server-side only).
APPWRITE_ENDPOINT=
APPWRITE_PROJECT_ID=
APPWRITE_API_KEY=
APPWRITE_BUCKET_ID=

# Optional dedicated secret for signing public gallery access tokens.
# If unset, one is derived from CLERK_SECRET_KEY.
# GALLERY_TOKEN_SECRET=

# Runtime
NODE_ENV=
PORT=
